# 从仓库根目录运行命令。复制到不纳入版本控制的 .env 文件。
ENV=development
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PORT=55432
# 生成本地密码（使用十六进制避免 URL 转义）：
# uv run python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
# 在下方填入同一个密码；空凭据不可用。
DATABASE_URL=postgresql+asyncpg://agenthub:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/agenthub
REDIS_PORT=56379
# 此开发环境的 Compose 中，Redis 仅绑定回环地址，不启用认证。
REDIS_URL=redis://127.0.0.1:56379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DEPENDENCY_TIMEOUT_SECONDS=2
ARTIFACT_STORE=local
# 使用私有可写目录。拒绝路径中任意部分的符号链接。
ARTIFACT_ROOT=.data/artifacts
ARTIFACT_MAX_BYTES=16777216
ARTIFACT_PENDING_SECONDS=300

# Unit 1.3：固定 8 小时 Session，不滑动续期。
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
# 名称/Secure 未配置时按 ENV 决定：dev 为 agenthub_session/false，prod 为 __Host-agenthub_session/true。
# SESSION_COOKIE_NAME=agenthub_session
# SESSION_COOKIE_SECURE=false
# Path 固定 /，不设置 Domain。无 Secure 的开发 Cookie 只允许 loopback Origin。
TRUSTED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
LOGIN_CSRF_TTL_SECONDS=600
# 生成独立的 32 字节随机密钥，十六进制编码；不要复用数据库密码。
# uv run python -c "import secrets; print(secrets.token_hex(32))"
# CSRF_SECRET=REPLACE_WITH_GENERATED_64_HEX_CHARACTERS
# dev/test 未提供密钥时每次启动生成临时值；多进程需共用配置值。
# 生产必须显式配置密钥、HTTPS Origin 和非默认数据库/Redis 凭据，不能使用本文件的开发组合。
PASSWORD_CONCURRENCY=2
LOGIN_RATE_WINDOW_SECONDS=300
LOGIN_RATE_SOURCE_LIMIT=60
LOGIN_RATE_ACCOUNT_LIMIT=10
LOGIN_RATE_NAMESPACE=agenthub:login:v1
# 可选：启动 Vite 时覆盖代理目标，默认 http://127.0.0.1:8000。
# AGENTHUB_API_PROXY_TARGET=http://127.0.0.1:8000

# Unit 1.4：仅 development/test 可显式运行 uv run python -m agenthub.cli seed-demo。
# 在本地 .env 配置 JSON：四个 key 为 demo-a-developer、demo-a-reviewer、
# demo-b-developer、demo-b-reviewer；各值是本地生成的 12–256 字符密码。
# 不提供可复用示例密码。重复执行不重置密码，撤权或数据冲突会拒绝执行。
# DEMO_SEED_PASSWORDS={}
