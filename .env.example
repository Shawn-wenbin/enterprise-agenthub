# Run commands from the repository root. Copy to untracked .env.
ENV=development
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PORT=55432
# Generate a local password (hex avoids URL escaping):
# uv run python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
# Substitute the SAME password below; empty credentials are not usable.
DATABASE_URL=postgresql+asyncpg://agenthub:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/agenthub
REDIS_PORT=56379
# Redis is loopback-only in this development Compose, without authentication.
REDIS_URL=redis://127.0.0.1:56379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DEPENDENCY_TIMEOUT_SECONDS=2
ARTIFACT_STORE=local
# A private writable directory. Symlinks in any component are rejected.
ARTIFACT_ROOT=.data/artifacts
ARTIFACT_MAX_BYTES=16777216
ARTIFACT_PENDING_SECONDS=300
